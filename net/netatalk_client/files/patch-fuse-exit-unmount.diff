--- fuse/commands.c.orig
+++ fuse/commands.c
@@ -670,8 +670,59 @@ static unsigned char process_ping(struct afpfsd_client * c)
     return AFPFSD_IPC_RESULT_OK;
 }
 
+/*!
+ * @brief Find a volume that is still mounted, on any server, and hold it
+ *
+ * @returns the volume, whose server the caller releases, or NULL
+ */
+static struct afp_volume *hold_mounted_volume(void)
+{
+    struct afp_volume *found = NULL;
+    afp_lock_server_list();
+
+    for (struct afp_server *s = get_server_base(); s && !found; s = s->next) {
+        for (int i = 0; i < s->num_volumes && !found; i++) {
+            if (__atomic_load_n(&s->volumes[i].mounted, __ATOMIC_ACQUIRE)
+                    == AFP_VOLUME_MOUNTED) {
+                afp_server_hold(s);
+                found = &s->volumes[i];
+            }
+        }
+    }
+
+    afp_unlock_server_list();
+    return found;
+}
+
 static unsigned char process_exit(struct afpfsd_client * c)
 {
+    static pthread_mutex_t exit_mutex = PTHREAD_MUTEX_INITIALIZER;
+    struct afp_volume *v;
+
+    /* Unmount here, while the main loop still serves the server's replies:
+     * once exit is triggered it serves none, and an unmount that flushes
+     * waits for one. The manager can send more than one exit command; the
+     * lock keeps a later one from ending the daemon during an unmount. */
+    pthread_mutex_lock(&exit_mutex);
+
+    while ((v = hold_mounted_volume()) != NULL) {
+        struct afp_server *s = v->server;
+        char mountpoint[AFP_MOUNTPOINT_LEN];
+        strlcpy(mountpoint, v->mountpoint, sizeof(mountpoint));
+        int ret = afp_unmount_volume(v);
+        afp_server_release(s);
+
+        if (ret != 0) {
+            log_for_client((void *)c, AFPFSD, LOG_WARNING,
+                           "Could not unmount %s before exiting", mountpoint);
+            break;
+        }
+
+        log_for_client((void *)c, AFPFSD, LOG_NOTICE,
+                       "Volume %s unmounted", mountpoint);
+    }
+
+    pthread_mutex_unlock(&exit_mutex);
     log_for_client((void *)c, AFPFSD, LOG_INFO,
                    "Exiting");
     return AFPFSD_IPC_RESULT_OK;
