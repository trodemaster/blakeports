--- fuse/commands.c.orig
+++ fuse/commands.c
@@ -757,9 +757,23 @@ static int check_mountpoint(struct afpfsd_client *c, const char *mountpoint)
     release_dead_mount(mountpoint);
 
     if (stat(mountpoint, &st) != 0) {
+        int stat_errno = errno;
+#ifdef HAVE_FSKIT_BACKEND
+        /* /Volumes is root's. macFUSE's helper creates a missing mount point
+         * directly under it for an FSKit mount, and the unmount removes it. */
+        const char *volumes = "/Volumes/";
+
+        if (stat_errno == ENOENT && access(FUSE_DEVICE, F_OK) != 0
+                && strncmp(mountpoint, volumes, strlen(volumes)) == 0
+                && mountpoint[strlen(volumes)] != '\0'
+                && strchr(mountpoint + strlen(volumes), '/') == NULL) {
+            return 0;
+        }
+
+#endif
         log_for_client((void *)c, AFPFSD, LOG_ERR,
                        "Mount point %s does not exist: %s",
-                       mountpoint, strerror(errno));
+                       mountpoint, strerror(stat_errno));
         return -1;
     }
 
