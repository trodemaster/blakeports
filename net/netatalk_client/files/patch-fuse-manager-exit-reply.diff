     return 0;
 }
 
+/* The longest wait for a daemon to answer an exit command */
+#define EXIT_REPLY_WAIT_S 15
+
 /* Send exit command to a socket path */
 static void send_exit_to_socket(const char *socket_path)
 {
@@ -355,6 +358,18 @@ static void send_exit_to_socket(const char *socket_path)
         if (afpfsd_ipc_write_all(sock, &cmd, sizeof(cmd)) < 0) {
             log_for_client(NULL, AFPFSD, LOG_WARNING,
                            "Could not send exit command to child daemon");
+        } else {
+            /* Keep the connection until the daemon has replied and closed
+             * it. macOS refuses setsockopt() on a socket whose peer has
+             * closed, and the daemon then drops the command unread. */
+            struct timeval tv = { EXIT_REPLY_WAIT_S, 0 };
+            char buf[256];
+            ssize_t n;
+            setsockopt(sock, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+
+            do {
+                n = read(sock, buf, sizeof(buf));
+            } while (n > 0 || (n < 0 && errno == EINTR));
         }
     }
 
