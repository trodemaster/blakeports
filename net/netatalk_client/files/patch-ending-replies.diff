+/*!
+ * @brief Leave only servers' descriptors in a set
+ *
+ * @param[in,out] set  the set
+ * @returns one past the set's highest descriptor, 0 for an empty set
+ */
+static int keep_server_fds(fd_set *set)
+{
+    fd_set servers;
+    int bound = 0;
+    FD_ZERO(&servers);
+    afp_lock_server_list();
+
+    for (struct afp_server *s = get_server_base(); s; s = s->next) {
+        int fd = __atomic_load_n(&s->fd, __ATOMIC_ACQUIRE);
+
+        if (fd >= 0 && fd < FD_SETSIZE && FD_ISSET(fd, set)) {
+            FD_SET(fd, &servers);
+            bound = max(bound, fd + 1);
+        }
+    }
+
+    afp_unlock_server_list();
+    *set = servers;
+    return bound;
+}
