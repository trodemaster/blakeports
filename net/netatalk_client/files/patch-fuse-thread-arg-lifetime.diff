+/* The mount handler returns once the mount starts or times out, but the FUSE
+ * thread lives until unmount and then reports its result.  The arg is shared
+ * on the heap, and whichever of the two finishes last frees it. */
+static void release_fuse_thread_arg(struct start_fuse_thread_arg *arg)
+{
+    if (__atomic_sub_fetch(&arg->refs, 1, __ATOMIC_ACQ_REL) == 0) {
+        free(arg->fuse_options);
+        free(arg);
+    }
+}
+
 /*
  * Remove commas from fsname, as it confuses the fuse option parser.
