variant fuse description {Enable FUSE-based AFP mounting (afp_client, mount_afpfs) via macFUSE} {
    configure.args-delete  -Denable-fuse=false
    configure.args-append  -Denable-fuse=true

    depends_build-append   path:bin/pkg-config:pkgconfig
    depends_lib-append     path:lib/pkgconfig/fuse3.pc:macfuse

    # macfuse's include/fuse.h is a compatibility header for FUSE 2, and
    # ${prefix}/include is searched before fuse3's own directory.
    configure.cppflags-prepend -I${prefix}/include/fuse3

    # One patch per worklist issue, see WORKLIST.md.

    # Without the macFUSE kernel extension there is no /dev/macfuse0; don't
    # require it, and mount through macFUSE's FSKit backend instead.
    patchfiles-append      patch-fuse-macos-fskit.diff

    # Upstream unmounts only off macOS, so `afpc fs unmount` and `afpc fs
    # exit` left volumes mounted.
    patchfiles-append      patch-fuse-macos-unmount.diff

    # /Volumes is root's. For an FSKit mount, macFUSE's helper creates a
    # missing mount point there, so don't insist that it exists.
    patchfiles-append      patch-fuse-macos-volumes-mountpoint.diff

    if {${os.major} >= 25} {
        notes "
        Mounting needs macFUSE's FSKit module and privileged helper, once per
        user and Mac, in a desktop Terminal window:

            open ${prefix}/Library/Filesystems/macfuse.fs/Contents/Resources/macfuse.app
            ${prefix}/Library/Filesystems/macfuse.fs/Contents/Resources/macfuse.app/Contents/MacOS/macfuse install --components privileged-helpers

        then enable macFUSE under System Settings > General > Login Items &
        Extensions > File System Extensions. A macfuse update
        can need both again.
        "
    }
}
