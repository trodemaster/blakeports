github.tarball_from archive

platforms           {darwin >= 21}

description         AFP file sharing client

long_description    Netatalk Client is a file sharing client written \
                    in C which can be used to access AFP shares exposed \
                    by multiple devices, notably personal file sharing \
                    on older Mac OS X and Classic Mac OS computers, \
                    Netatalk servers hosted on Linux/*BSD/Solaris/macOS, \
                    Apple AirPort and Time Capsule products as well as \
                    other AFP enabled NAS devices from various vendors. \
                    Netatalk Client is an improved fork of afpfs-ng.

homepage            https://netatalk.io/

checksums           rmd160  3f088b7e103f4a391fcc58afcf5fea30e00aedd8 \
                    sha256  7320202ba8bd962bbc23f9c6851cf7e257e00671d361a92eac2df55529d8d730 \
                    size    336293

# DNS-SD lives in libSystem on macOS; don't link Avahi's libdns_sd shim
patchfiles          patch-dnssd-libsystem.diff

meson.wrap_mode     nodownload

depends_lib-append  port:libgcrypt \
                    port:libiconv \
                    port:readline

compiler.c_standard 2011

configure.args-append \
                    -Denable-fuse=false

variant fuse description {Enable FUSE-based AFP mounting (afp_client, mount_afpfs) via macFUSE} {
    configure.args-delete  -Denable-fuse=false
    configure.args-append  -Denable-fuse=true

    depends_build-append   path:bin/pkg-config:pkgconfig
    depends_lib-append     path:lib/pkgconfig/fuse3.pc:macfuse

    # macfuse installs a compatibility include/fuse.h that resolves to its
    # bundled FUSE 2.x-style API. Since ${prefix}/include is always on the
    # search path ahead of ${prefix}/include/fuse3, bare `#include <fuse.h>`
    # picks up the wrong (FUSE 2.x) struct layout even when linking fuse3.
    # Point the FUSE daemon sources at fuse3/fuse.h explicitly.
    patchfiles-append      patch-fuse3-header.diff

    # Without the macFUSE kernel extension there is no /dev/macfuse0; don't
    # require it, and mount via macFUSE's FSKit backend instead.
    patchfiles-append      patch-fuse-macos-fskit.diff

    # Upstream implements programmatic unmount only off macOS, so
    # `afpc fs unmount` and `afpc fs exit` left volumes mounted. Unmount the
    # mount point with unmount(2) and wait for the FUSE thread.
    patchfiles-append      patch-fuse-macos-unmount.diff

    # The FUSE thread wrote its result into the mount handler's stack frame
    # after unmount, long after the handler returned; on macOS this crashes
    # afpfsd before it can log out. Keep that state on the heap instead.
    patchfiles-append      patch-fuse-thread-arg-lifetime.diff

    # Once exit is triggered the main loop stops reading server replies, so
    # unmounting from the exit path stalls and the session ends in a reset.
    # Unmount from the `fs exit` handler first, while replies still flow.
    patchfiles-append      patch-fuse-exit-unmount.diff

    # /Volumes is root-owned. With FSKit, macFUSE's privileged helper creates
    # a missing mount point there for the user and removes it on unmount, so
    # don't insist the directory exist beforehand.
    patchfiles-append      patch-fuse-macos-volumes-mountpoint.diff

    # The manager sent each mount daemon two exit commands and closed the
    # socket without reading the reply, so the daemon printed "Writing:
    # Broken pipe". Send once per daemon and wait for its reply.
    patchfiles-append      patch-fuse-manager-exit-reply.diff

    # Truncating through an open fork (O_TRUNC, ftruncate) compared against
    # a cached size that starts at 0, so truncation to 0 was skipped and the
    # server kept the old contents. Always send SetForkParms.
    patchfiles-append      patch-fuse-truncate-open-fork.diff
}
