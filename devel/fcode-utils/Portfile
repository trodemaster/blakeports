description             Utilities to process FCode, Open Firmware's byte code
long_description        {*}${description}. Provides toke, the FCode \
                        tokenizer, along with detok and romheaders. OpenBIOS \
                        requires toke to build its Forth dictionaries, so \
                        this is a build dependency of \
                        emulators/openbios-mac99-smp.

homepage                https://openfirmware.info/FCODE_suite

checksums               rmd160  40de26ee328ec8dceb736a010a91d5f44411360f \
                        sha256  c37ccda5599495f47704d5d84a3a3401135ac6528c193dfe1b5fe354fe17b43c \
                        size    4312278

# Plain recursive makefiles, no configure script.
use_configure           no

# The makefiles default to CFLAGS ?= -O2 -Wall -Werror, and this is 2009 era
# code, so current clang fails it on warnings that did not exist then:
#
#   toke.c:232: error: variable 'argindx' set but not used
#     [-Werror,-Wunused-but-set-variable]
#
# CFLAGS is assigned with ?= and INCLUDES is kept separate, so overriding it
# here drops -Werror without losing the include paths. -Wno-pointer-sign is
# what the makefiles' own _GCC4_CFLAGS probe adds, replicated because a
# command line CFLAGS suppresses their later := append.
set fc_cflags           "${configure.cflags} -Wall -Wno-pointer-sign"

build.args-append       CC=${configure.cc} \
                        CFLAGS="${fc_cflags}"

# Note the unusual convention: the per-tool makefiles treat DESTDIR as an
# install *prefix*, not as a staging root:
#
#     DESTDIR ?= /usr/local
#     install: mkdir -p $(DESTDIR)/bin && cp $(PROGRAM) $(DESTDIR)/bin/...
#
# MacPorts would otherwise pass DESTDIR=${destroot} and drop the binaries in
# ${destroot}/bin rather than ${destroot}${prefix}/bin.
destroot.destdir        DESTDIR=${destroot}${prefix}
destroot.args-append    CC=${configure.cc} \
                        CFLAGS="${fc_cflags}"

livecheck.type          none
