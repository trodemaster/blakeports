+	LogsInAutomatically bool   `yaml:"logsInAutomatically,omitempty" json:"logsInAutomatically,omitempty"`
+	EnablesRemoteLogin  bool   `yaml:"enablesRemoteLogin,omitempty" json:"enablesRemoteLogin,omitempty"`
 }
 
