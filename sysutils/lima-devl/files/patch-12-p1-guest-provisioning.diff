+		out, err := exec.CommandContext(ctx, "pgrep", "-l", "-U", strconv.Itoa(uid)).Output()
+		if err == nil {
+			return fmt.Errorf("processes are running as uid %d: %#q", uid, strings.TrimSpace(string(out)))
