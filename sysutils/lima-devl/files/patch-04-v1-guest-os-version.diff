+// readOptionalInstanceFile returns the trimmed content of instDir/name, or an
+// empty string if the file does not exist. Any other read error is logged and
+// also yields an empty string: callers treat "" as "unknown".
+func readOptionalInstanceFile(instDir, name string) string {
+	b, err := os.ReadFile(filepath.Join(instDir, name))
+	if err != nil {
+		if !errors.Is(err, os.ErrNotExist) {
+			logrus.WithError(err).Warnf("Failed to read %s", name)
+		}
+		return ""
+	}
+	return strings.TrimSpace(string(b))
+}
