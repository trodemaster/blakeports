 import Foundation
+import Security
+
+/// MacPorts: oMLX server secrets live in the login keychain instead of
+/// settings.json. Generic passwords, service "app.omlx.server", accounts
+/// "api-key" and "secret-key". They reach the server as OMLX_API_KEY and
+/// OMLX_SECRET_KEY in its spawn environment, and the server keeps
+/// env-supplied secrets out of settings.json when it saves.
+///
+/// Each item is read once per app run and cached, so a pending keychain
+/// prompt can't repeat on every config reload. Restart the app after
+/// rotating a secret.
+enum ServerSecrets {
+    static let service = "app.omlx.server"
+
+    private final class Cache: @unchecked Sendable {
+        let lock = NSLock()
+        var values: [String: String?] = [:]
+    }
+    private static let cache = Cache()
+
+    static func read(account: String) -> String? {
+        cache.lock.lock()
+        defer { cache.lock.unlock() }
+        if let cached = cache.values[account] { return cached }
+        let value = lookup(account: account)
+        cache.values[account] = .some(value)
+        return value
+    }
+
+    private static func lookup(account: String) -> String? {
+        let query: [String: Any] = [
+            kSecClass as String: kSecClassGenericPassword,
+            kSecAttrService as String: service,
+            kSecAttrAccount as String: account,
+            kSecMatchLimit as String: kSecMatchLimitOne,
+            kSecReturnData as String: true,
+        ]
+        var item: CFTypeRef?
+        guard SecItemCopyMatching(query as CFDictionary, &item) == errSecSuccess,
+              let data = item as? Data,
+              let value = String(data: data, encoding: .utf8)?
+                .trimmingCharacters(in: .whitespacesAndNewlines),
+              !value.isEmpty
+        else { return nil }
+        return value
+    }
+
+    static var apiKey: String? { read(account: "api-key") }
+    static var secretKey: String? { read(account: "secret-key") }
+}
 
