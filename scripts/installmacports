#!/bin/bash
set -euo pipefail
IFS=$'\n\t'
shopt -s nullglob nocaseglob

# BlakePorts MacPorts Configuration Script
# This script configures MacPorts sources.conf for GitHub Actions runners
# to use the local blakeports checkout as the default port source.
#
# Prerequisites: MacPorts must already be installed (handled by packer VM image)

# track if we need to sync macports
NEED_SYNC=false

# Verify MacPorts is installed
if [ ! -f /opt/local/bin/port ]; then
  echo "Error: MacPorts is not installed."
  echo ""
  echo "For Lima runners, install MacPorts before registering the runner:"
  echo "  make run-<instance>       # start the VM (e.g. make run-26)"
  echo "  make macports-<instance>  # install MacPorts (e.g. make macports-26)"
  echo "  make register-<instance>  # then register the runner"
  echo ""
  echo "macports.sh is at /Volumes/lima_mac/macports.sh inside the VM."
  exit 1
fi

echo "✓ MacPorts is installed"

# Configure macports sources.conf for GitHub Actions runner
# This adds the local blakeports checkout as the default source
if ! grep -q "blakeports" /opt/local/etc/macports/sources.conf; then
  echo "Configuring macports /opt/local/etc/macports/sources.conf"
  sudo tee /opt/local/etc/macports/sources.conf <<EOF
file:///opt/actions-runner/_work/blakeports/blakeports [default]
rsync://rsync.macports.org/macports/release/tarballs/ports.tar.gz
EOF
  NEED_SYNC=true
else
  echo "✓ MacPorts sources.conf already configured for blakeports"
fi

# set up macports environment for current session
export PATH="/opt/local/bin:/opt/local/sbin:$PATH"
export MANPATH="/opt/local/share/man:${MANPATH:-}"

# Always regenerate the blakeports PortIndex from what is actually checked out.
# This ensures stale entries from the developer's local machine are never used.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
echo "Regenerating blakeports port index..."
(cd "$REPO_ROOT" && portindex >/dev/null 2>&1)
echo "✓ Port index regenerated"

# An interrupted sync can leave a zero-size (or truncated) official ports.tar
# behind. Later syncs then report "No updates" and the official tree is never
# fetched, so detect that state and force a clean sync.
OFFICIAL_TARBALL_GLOB=(/opt/local/var/macports/sources/*/macports/release/tarballs)
if [[ "$NEED_SYNC" != "true" ]]; then
  for dir in "${OFFICIAL_TARBALL_GLOB[@]}"; do
    for tarball in "$dir"/ports.tar*; do
      if [[ -f "$tarball" && ! -s "$tarball" ]]; then
        echo "Official $tarball is empty - forcing sync"
        NEED_SYNC=true
      fi
    done
  done
fi
if [[ "$NEED_SYNC" != "true" ]]; then
  if ! port info go >/dev/null 2>&1; then
    echo "'port info go' failed - official ports tree missing, forcing sync"
    NEED_SYNC=true
  fi
fi

# sync macports to update port index (only if needed)
# Note: -v flag is required due to MacPorts bug "can't read verboseflag: no such variable"
# Output is logged because it is tens of thousands of lines; the tail is shown on failure.
if [[ "$NEED_SYNC" == "true" ]]; then
  echo "Syncing MacPorts port index..."
  SYNC_LOG="$(mktemp)"
  if ! sudo port -v sync >"$SYNC_LOG" 2>&1; then
    echo "Error: port sync failed. Last 30 lines of output:" >&2
    tr '\r' '\n' <"$SYNC_LOG" | tail -n 30 >&2
    # A failed sync can leave an empty/partial tarball that blocks later syncs
    # ("No updates"). Remove it, plus the stale ports dir whose mtime gates it.
    OFFICIAL_TARBALL_GLOB=(/opt/local/var/macports/sources/*/macports/release/tarballs)
    for dir in "${OFFICIAL_TARBALL_GLOB[@]}"; do
      for tarball in "$dir"/ports.tar*; do
        echo "Removing incomplete $tarball" >&2
        sudo rm -rf "$tarball" "$dir/ports"
      done
    done
    rm -f "$SYNC_LOG"
    exit 1
  fi
  rm -f "$SYNC_LOG"
else
  echo "✓ Skipping port sync - no changes detected"
fi

echo "✓ MacPorts setup complete!"

exit 0
