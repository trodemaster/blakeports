# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=portfile:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           crossgcc 1.0

crossgcc.setup      powerpc-elf 12.4.0
crossgcc.setup_libc newlib 3.1.0
revision            0

maintainers         {@trodemaster icloud.com:manuals-unread2u} openmaintainer

# Bare-metal powerpc-elf compiler, needed to build the OpenBIOS PowerPC ROM
# (see emulators/openbios-mac99-smp). OpenBIOS compiles freestanding and
# brings its own libc, so newlib is only here because the crossgcc portgroup
# wants a libc to build against.
#
# 12.4.0 matches what cross/i386-elf-gcc uses upstream, on the theory that a
# gcc version already exercised by another cross port is the safer bet for
# OpenBIOS, which is old code and unhappy with some newer compilers.

# Build without NLS. gcc's system.h only pulls in <libintl.h> under
# ENABLE_NLS, and MacPorts' gettext header defines setlocale as a macro, which
# collides with the declaration libcpp/system.h makes:
#
#   /opt/local/include/libintl.h:1091:34: error: expected unqualified-id
#   note: expanded from macro 'setlocale'
#
# The crossgcc portgroup depends on gettext but never passes --disable-nls.
# Localised diagnostics are of no value in a bare-metal cross compiler that
# exists only to build a boot ROM, so turn them off rather than patch gcc.
configure.args-append   --disable-nls
