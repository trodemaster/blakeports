#!/bin/sh
# Install or remove the DXVK D3D10/11 DLLs in a wine prefix.
# Usage: wine-dxvk install|uninstall|status   (prefix: $WINEPREFIX or ~/.wine)

dxvk=@PREFIX@/lib/dxvk
dlls="dxgi d3d11 d3d10core"
prefix=${WINEPREFIX:-$HOME/.wine}
wine=@PREFIX@/bin/wine

usage() {
    echo "Usage: $0 install|uninstall|status" >&2
    echo "Acts on \$WINEPREFIX (default ~/.wine)." >&2
    exit 1
}

[ $# -eq 1 ] || usage
if [ ! -f "$prefix/system.reg" ]; then
    echo "$prefix: not a wine prefix; run a wine program once to create it" >&2
    exit 1
fi

sys64=$prefix/drive_c/windows/system32
sys32=$prefix/drive_c/windows/syswow64

override() {
    WINEDEBUG=-all WINEPREFIX=$prefix "$wine" reg "$@" >/dev/null 2>&1
}

case $1 in
install)
    for dll in $dlls; do
        for pair in "$sys64 x86_64-windows" "$sys32 i386-windows"; do
            set -- $pair
            dst=$1/$dll.dll
            [ -f "$dst" ] && [ ! -f "$dst.old" ] && mv "$dst" "$dst.old"
            cp "$dxvk/$2/$dll.dll" "$dst" || exit 1
        done
        override add 'HKEY_CURRENT_USER\Software\Wine\DllOverrides' /v $dll /d native /f \
            || { echo "failed to add the $dll override" >&2; exit 1; }
        echo "installed $dll"
    done
    ;;
uninstall)
    for dll in $dlls; do
        for dir in "$sys64" "$sys32"; do
            dst=$dir/$dll.dll
            [ -f "$dst.old" ] && mv -f "$dst.old" "$dst"
        done
        override delete 'HKEY_CURRENT_USER\Software\Wine\DllOverrides' /v $dll /f
        echo "removed $dll"
    done
    ;;
status)
    for dll in $dlls; do
        if cmp -s "$dxvk/x86_64-windows/$dll.dll" "$sys64/$dll.dll"; then
            echo "$dll: dxvk"
        else
            echo "$dll: wine"
        fi
    done
    ;;
*)
    usage
    ;;
esac
