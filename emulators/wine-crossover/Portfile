# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem                  1.0
PortGroup                   muniversal 1.1

# Personal port, not for macports-ports. Modelled on emulators/wine-stable;
# CrossOver 26 is based on Wine 11.0. Built x86_64 only, runs under Rosetta 2.

name                        wine-crossover
version                     26.3.0
revision                    0
conflicts                   wine-stable wine-devel wine-staging
license                     LGPL-2.1+
# Only built and tested on macOS 27 (Apple silicon, Rosetta 2)
platforms                   {darwin >= 27}
categories                  emulators
supported_archs             x86_64
maintainers                 {@trodemaster icloud.com:manuals-unread2u} openmaintainer
homepage                    https://www.codeweavers.com/crossover/source

description \
    A Windows API implementation (Wine with CodeWeavers modifications for CrossOver)

long_description \
    Wine is a compatibility layer capable of running \
    Windows applications. \
    This version is built from the CrossOver ${version} sources \
    and contains the CodeWeavers patches for CrossOver. \
    Instead of simulating internal Windows logic like \
    a virtual machine or emulator, Wine translates \
    Windows API calls into POSIX calls on-the-fly, \
    eliminating the performance and memory penalties \
    of other methods and allowing you to cleanly \
    integrate Windows applications into your desktop.

# The tarball's nettle lacks its generated files (Makefile.in, configure);
# it is otherwise identical to the upstream release, so fetch that.
set nettle_version          3.10
set nettle_distfile         nettle-${nettle_version}.tar.gz

master_sites                https://media.codeweavers.com/pub/crossover/source/:crossover \
                            gnu:nettle:nettle
distname                    crossover-sources-${version}
dist_subdir                 ${name}
worksrcdir                  sources/wine
distfiles                   ${distname}${extract.suffix}:crossover \
                            ${nettle_distfile}:nettle

checksums                   ${distname}${extract.suffix} \
                            rmd160  fc8524195934f0833441e0834c0819ccceec2c73 \
                            sha256  ac99c8ca4b3848f3e81784135f023df266b61c2345726ea55a50b3e030dd6872 \
                            size    149054023 \
                            ${nettle_distfile} \
                            rmd160  b674bd8f36bb73ca6a2fdb6c3885374c89c3b9e7 \
                            sha256  b4c518adb174e484cb4acea54118f02380c7133771e7e9beb98a0787194ee47c \
                            size    2640485

# The tarball also carries moltenvk, gstreamer, etc.; only wine, gnutls and dxvk are built.
extract.only                ${distname}${extract.suffix}
extract.post_args-append    ${worksrcdir} sources/gnutls sources/dxvk

# gnutls, nettle and gmp are built x86_64 into a private libdir, as CrossOver
# does. Universal MacPorts gmp and libffi (via p11-kit) are broken on Xcode 27:
# muniversal's libtool fallback turns their differing headers into ar archives.
set cx_libdir               ${prefix}/libexec/${name}/lib
set cxdeps                  ${workpath}/cxdeps

depends_build \
    bin:flex:flex \
    port:bison \
    port:gettext \
    port:glslang \
    port:m4 \
    port:meson \
    port:mingw-w64 \
    port:ninja \
    path:bin/pkg-config:pkgconfig

# Build tools run natively; without this, base upgrades them (and their whole
# trees, e.g. glslang -> python314 -> libffi) +universal for the x86_64 build.
depends_skip_archcheck-append \
    bison flex gettext glslang m4 meson mingw-w64 ninja pkgconfig

depends_lib \
    port:freetype \
    port:gettext-runtime \
    port:libpcap \
    port:libsdl2 \
    path:lib/libMoltenVK.dylib:MoltenVK-latest

depends_run \
    port:mingw-w64-wine-gecko-2.47.4 \
    port:mingw-w64-wine-mono-10.4.1

post-extract {
    system -W ${workpath} "${extract.cmd} -dc ${distpath}/${nettle_distfile} | tar -xf -"

    # https://gitlab.winehq.org/wine/wine/-/commit/c7a97b5d5d56ef00a0061b75412c6e0e489fdc99
    reinplace -q "/PKG_CONFIG_LIBDIR/d"  ${worksrcpath}/configure
    reinplace -q "/PKG_CONFIG_LIBDIR/d"  ${worksrcpath}/configure.ac
}

# cstdint, stateblock-uuid: dxvk 1.10.3 vs mingw-w64 gcc 15 and its headers.
# macos-features: CrossOver's dxvk relies on CodeWeavers' MoltenVK faking
# geometryShader etc.; request them only if supported, as Gcenx/DXVK-macOS does.
patch.dir                   ${workpath}/sources
patchfiles                  patch-dxvk-cstdint.diff \
                            patch-dxvk-d3d10-stateblock-uuid.diff \
                            patch-dxvk-macos-features.diff

proc cx_build_dep {dir cx_env args} {
    global build.jobs
    system -W ${dir} "env -u CPATH -u LIBRARY_PATH ${cx_env} ./configure [join ${args}]"
    system -W ${dir} "make -j${build.jobs}"
    system -W ${dir} "make install"
}

pre-configure {
    set triplet x86_64-apple-darwin${os.major}
    set cx_env "CC='[lindex ${configure.cc} 0] -arch x86_64' CFLAGS=-O2 \
        CPPFLAGS=-I${cxdeps}/include \
        LDFLAGS='-L${cxdeps}/lib -Wl,-headerpad_max_install_names' \
        PKG_CONFIG_LIBDIR=${cxdeps}/lib/pkgconfig \
        MACOSX_DEPLOYMENT_TARGET=${macosx_deployment_target}"
    set common "--prefix=${cxdeps} --build=${triplet} --host=${triplet} \
        --disable-static --enable-shared"

    cx_build_dep ${workpath}/sources/gnutls/gmp \
        "${cx_env} M4=${prefix}/bin/gm4 ABI=64" ${common}

    cx_build_dep ${workpath}/nettle-${nettle_version} ${cx_env} ${common} \
        --disable-documentation --disable-openssl \
        --with-include-path=${cxdeps}/include --with-lib-path=${cxdeps}/lib

    # LIBS: its nettle_* function checks link only -lhogweed, which does not
    # re-export libnettle's symbols on macOS, so they all fail.
    cx_build_dep ${workpath}/sources/gnutls/gnutls "${cx_env} LIBS=-lnettle" ${common} \
        --disable-doc --disable-tools --disable-cxx --disable-tests \
        --disable-nls --disable-libdane \
        --disable-hardware-acceleration \
        --with-included-libtasn1 --with-included-unistring \
        --without-p11-kit --without-idn --without-tpm --without-tpm2 \
        --without-brotli --without-zstd --without-zlib
}

# wine requires the program specified in INSTALL to create intermediate
# directories; /usr/bin/install doesn't.
# http://bugs.winehq.org/show_bug.cgi?id=35310
configure.install \
    ${worksrcpath}/tools/install-sh

configure.args.x86_64 \
    --enable-archs=i386,x86_64 \
    --enable-win64

configure.args \
    --without-alsa \
    --without-capi \
    --with-coreaudio \
    --with-cups \
    --without-dbus \
    --without-ffmpeg \
    --without-fontconfig \
    --with-freetype \
    --with-gettext \
    --without-gettextpo \
    --without-gphoto \
    --with-gnutls \
    --without-gssapi \
    --without-gstreamer \
    --without-inotify \
    --without-krb5 \
    --with-mingw \
    --without-netapi \
    --with-opencl \
    --with-opengl \
    --without-oss \
    --with-pcap \
    --with-pcsclite \
    --with-pthread \
    --without-pulse \
    --without-sane \
    --with-sdl \
    --without-udev \
    --with-unwind \
    --without-usb \
    --with-vulkan \
    --without-wayland \
    --without-x

configure.args-append \
    --disable-tests \
    --disable-winebth_sys \
    --disable-winemenubuilder

# Absolute soname, so wine dlopen()s the private gnutls, never an arm64 MacPorts one.
configure.env-append \
    GNUTLS_CFLAGS=-I${cxdeps}/include \
    "GNUTLS_LIBS=-L${cxdeps}/lib -lgnutls" \
    ac_cv_lib_soname_gnutls=${cx_libdir}/libgnutls.30.dylib

# We need to tell the linker to add MacPorts to the rpath stack.
configure.ldflags-append    -Wl,-rpath,${compiler.library_path}

# wine requires clang >= 3.8
# FSF GCC cannot compile code using Apple's "blocks" language extensions
compiler.blacklist-append   {*gcc*} {clang < 800} {macports-clang-3.*}

# Setting an older deployment target avoids build error with newer SDKs
# https://gitlab.winehq.org/wine/wine/-/merge_requests/5935#note_74758
macosx_deployment_target    10.15

variant gphoto description "Build ${subport} with support for digital cameras" {
    depends_lib-append      port:libgphoto2
    configure.args-replace  --without-gphoto --with-gphoto
}

variant ffmpeg description "Build ${subport} with FFmpeg-based implementation for the MF byte stream handlers" {
    # Use the same version of ffmpeg as gstreamer1-gst-libav
    set ffmpeg_ver          6
    depends_lib-append      port:ffmpeg${ffmpeg_ver}
    configure.args-replace  --without-ffmpeg --with-ffmpeg
    configure.pkg_config_path   ${prefix}/libexec/ffmpeg${ffmpeg_ver}/lib/pkgconfig
}

variant gstreamer description "Build ${subport} with GStreamer, for multimedia support" {
    depends_lib-append      port:gstreamer1 port:gstreamer1-gst-plugins-base port:gstreamer1-gst-plugins-good \
        port:gstreamer1-gst-plugins-bad port:gstreamer1-gst-plugins-ugly port:gstreamer1-gst-libav
    configure.args-replace  --without-gstreamer --with-gstreamer
}

variant kerberos description "Build ${subport} with Kerberos, for network authentication protocol support" {
    depends_lib-append      port:kerberos5
    configure.args-replace  --without-krb5 --with-krb5
}

triplet.add_build           cross
triplet.add_host            none

# macports-base injects a number of flags that now propagate to mingw-gcc this causes the build to fail since, wine-7.21
# https://gitlab.winehq.org/wine/wine/-/commit/b1f59bc679a8c2dea18a6789a5b9b1a1ae825129
compiler.limit_flags        yes
muniversal.arch_flag        no
muniversal.arch_compiler    yes
configure.ldflags-delete    -L${compiler.library_path}
configure.optflags          -O2
configure.env-append        "CROSSCFLAGS=${configure.optflags}"

# Were only installing wine not the development files
destroot.target             install-lib

# DXVK (D3D10/11 over Vulkan/MoltenVK). No d3d9: wined3d over OpenGL does it better on macOS.
set dxvk_dlls               {dxgi d3d11 d3d10core}

post-build {
    set dxvk_src ${workpath}/sources/dxvk
    foreach {bits arch} {64 x86_64 32 i386} {
        system -W ${workpath} "env -u CFLAGS -u CXXFLAGS -u CPPFLAGS -u LDFLAGS -u CPATH -u LIBRARY_PATH \
            ${prefix}/bin/meson setup --cross-file ${dxvk_src}/build-win${bits}.txt \
            --buildtype release --strip --prefix ${workpath}/dxvk \
            --bindir ${arch}-windows --libdir ${arch}-windows \
            -Denable_tests=false -Denable_d3d9=false \
            ${workpath}/dxvk-build${bits} ${dxvk_src}"
        system "${prefix}/bin/ninja -j${build.jobs} -C ${workpath}/dxvk-build${bits} install"
    }
}

post-destroot {
    set docdir ${prefix}/share/doc/${subport}
    xinstall -d ${destroot}${docdir}
    xinstall -m 0644 -W ${worksrcpath} \
        ANNOUNCE.md \
        AUTHORS \
        COPYING.LIB \
        LICENSE \
        README.md \
        ${destroot}${docdir}

    set libs {libgmp.10 libnettle.8 libhogweed.6 libgnutls.30}
    xinstall -d ${destroot}${cx_libdir}
    foreach lib ${libs} {
        set dylib ${destroot}${cx_libdir}/${lib}.dylib
        xinstall -m 0755 ${cxdeps}/lib/${lib}.dylib ${dylib}
        system "install_name_tool -id ${cx_libdir}/${lib}.dylib ${dylib}"
        foreach dep ${libs} {
            system "install_name_tool -change ${cxdeps}/lib/${dep}.dylib ${cx_libdir}/${dep}.dylib ${dylib}"
        }
        system "/usr/bin/codesign --force --sign - ${dylib}"
    }

    xinstall -m 0644 ${workpath}/sources/gnutls/gmp/COPYING.LESSERv3 ${destroot}${docdir}/gmp-COPYING.LESSERv3
    xinstall -m 0644 ${workpath}/nettle-${nettle_version}/COPYING.LESSERv3 ${destroot}${docdir}/nettle-COPYING.LESSERv3
    xinstall -m 0644 ${workpath}/sources/gnutls/gnutls/LICENSE ${destroot}${docdir}/gnutls-LICENSE

    foreach arch {x86_64 i386} {
        set dir ${destroot}${prefix}/lib/dxvk/${arch}-windows
        xinstall -d ${dir}
        foreach dll ${dxvk_dlls} {
            xinstall -m 0644 ${workpath}/dxvk/${arch}-windows/${dll}.dll ${dir}
        }
    }
    xinstall -m 0644 ${workpath}/sources/dxvk/LICENSE ${destroot}${docdir}/dxvk-LICENSE
    xinstall -m 0755 ${filespath}/wine-dxvk ${destroot}${prefix}/bin
    reinplace "s|@PREFIX@|${prefix}|g" ${destroot}${prefix}/bin/wine-dxvk
}

notes "
    ${subport} is x86_64 only and runs under Rosetta 2. If it is not\
    installed yet: softwareupdate --install-rosetta --agree-to-license

    DXVK (Direct3D 10/11 over MoltenVK) is installed but off by default.\
    Turn it on or off per prefix with: wine-dxvk install | uninstall
"

livecheck.type              regex
livecheck.url               https://media.codeweavers.com/pub/crossover/source/
livecheck.regex             {crossover-sources-([0-9.]+)\.tar\.gz}
