                        --disable-spice \
                        --disable-libiscsi \
                        --disable-rbd \
                        --disable-smartcard \
                        --disable-usb-redir \
                        --disable-seccomp \
                        --disable-linux-aio \
                        --disable-rdma \
                        --disable-libssh \
                        --disable-gcrypt \
                        --disable-nettle \
                        --disable-numa \
                        --disable-xen \
                        --disable-dbus-display \
                        --disable-fuse \
                        --disable-docs \
                        --disable-guest-agent

# The qemu build system bugs out when using in-source-tree builds, so build
# out of source. See the comment in emulators/qemu for the full explanation.
configure.dir           "${workpath}/build"
configure.cmd           "${worksrcpath}/configure"
build.dir               "${workpath}/build"

pre-configure {
    file mkdir ${configure.dir}
}

# cat7's audio/coreaudio.m calls CoreFoundation and tests/audio/test-audio,
# which "make all" builds, does not link it, so that link fails with
# undefined _CF* and Objective-C runtime symbols.
configure.ldflags-append    -framework CoreFoundation -framework Foundation

pre-configure {
    configure.args-append --extra-ldflags="${configure.ldflags}"
}

# QEMU builds with -O2, but MacPorts' default -Os comes later on the command
# line and wins. The emulator's TCG hot paths are measurably slower at -Os
# (about 3% on a 16-vCPU guest build), so use QEMU's own level. LTO is worth
# another 4-7% on the same build; -O3, with or without LTO, gains nothing.
configure.optflags      -O2
configure.args-append   --enable-lto

# disable silent rules
build.args-append       V=1

# Publish a suffixed symlink so both this port and port:qemu can be active.
# Only the emulator is built (--disable-tools): qemu-img and the other tools
# are not specific to the G5 fork, so use the ones from port:qemu or any
# other QEMU build.
post-destroot {
    xinstall -d ${destroot}${prefix}/bin
    ln -s ${qemu_prefix}/bin/qemu-system-ppc64 \
          ${destroot}${prefix}/bin/qemu-system-ppc64-cat7
}

notes "
This port installs alongside the stock qemu port. Its emulator is:

    ${prefix}/bin/qemu-system-ppc64-cat7

The Power Mac G5 (PowerMac7,3) needs cat7's OpenBIOS firmware, which this
port does not provide: QEMU's own pc-bios/openbios-ppc is not the G5 build.
Use openbios-qemu.elf from cat7's G5 OpenBIOS download (source:
https://github.com/cat7/openbios, branch G5-openbios) and point -bios at it.
No Apple ROM is needed.

Decrementer cap: for guests with 8 or more CPUs, Mac OS X can panic in
pmap_unnest. Set the machine property decr-cap-ms, for example
-machine mac99,decr-cap-ms=100, to fire a 970's decrementer at least
that often. Off by default.

App Nap: the cocoa display opts out of App Nap while QEMU runs, so an
unfocused window is no longer throttled.
"

# Default universal variant does not work
universal_variant       no

livecheck.type          none
