# This port deliberately coexists with port:qemu rather than conflicting with
# it. Everything is installed into a private prefix so that no file (binary,
# firmware blob under share/qemu, keymap, ...) collides with the stock port,
# and only a suffixed symlink is published into ${prefix}/bin.
#
# QEMU locates its own firmware relative to the running executable
# (util/cutils.c: qemu_init_exec_dir() -> _NSGetExecutablePath() + realpath(),
# then get_relocated_path()), and meson's "relocatable" option defaults to
# true. Because the lookup realpath()s through the symlink, the wrapper below
# resolves to the private prefix and QEMU finds its matching pc-bios.
set qemu_prefix         ${prefix}/libexec/${name}

set py_branch           3.14
set py_version          [string replace ${py_branch} 1 1]

depends_build-append    port:ninja \
                        path:bin/pkg-config:pkgconfig \
                        port:py${py_version}-distlib \
                        port:py${py_version}-meson

depends_lib-append      path:lib/pkgconfig/glib-2.0.pc:glib2 \
                        path:lib/pkgconfig/pixman-1.pc:libpixman \
                        port:bzip2 \
                        port:libslirp \
                        port:lzo2 \
                        port:snappy \
                        port:zlib \
                        port:zstd \
                        port:dtc \
                        port:libusb \
                        port:libpng \
                        port:libjpeg-turbo \
                        port:gnutls

# Put the extra sources where the meson wraps would have put them. Both
# berkeley wraps carry a patch_directory (subprojects/packagefiles/<name>),
# an overlay of meson.build files meson only applies when it downloads the
# wrap itself, so apply it here as a release tarball would have it.
post-extract {
    foreach {sub dirname} [list \
            keycodemapdb    keycodemapdb-${keycodemapdb_rev} \
            berkeley-softfloat-3 berkeley-softfloat-3-${softfloat_rev} \
            berkeley-testfloat-3 berkeley-testfloat-3-${testfloat_rev}] {
        move ${workpath}/${dirname} ${worksrcpath}/subprojects/${sub}
        set overlay ${worksrcpath}/subprojects/packagefiles/${sub}
        if {[file isdirectory ${overlay}]} {
            foreach f [glob -directory ${overlay} *] {
                copy ${f} ${worksrcpath}/subprojects/${sub}
            }
        }
    }
}

# ERROR: You either need GCC v7.4 or Clang v10.0 (or XCode Clang v15.0)
compiler.blacklist      {clang < 1500} {macports-clang-[3-9].*} {macports-gcc-[56]} {*gcc-[34].*}

if {"${configure.build_arch}" eq "arm64"} {
    set host_cpu "aarch64"
} else {
    set host_cpu "${configure.build_arch}"
}

# Install into the private prefix instead of ${prefix}
configure.pre_args-replace  --prefix=${prefix} --prefix=${qemu_prefix}

configure.args          --cpu=${host_cpu} \
                        --cc=${configure.cc} \
                        --objcc=${configure.objc} \
                        --host-cc=${configure.cc}

# VNC (a machine can show its screen over VNC), USB passthrough from the host
# and virtio-9p shared folders are all described in cat7's G5 readme, so they
# are enabled below, with the libraries they need in depends_lib. VNC password
# authentication needs DES, which only a crypto backend provides (gnutls here);
# without one QEMU refuses "-vnc ...,password-secret=" outright.
# Only the G5 is of interest here
configure.args-append   --target-list=ppc64-softmmu

# Do not use iasl, even if it is installed, #43911
configure.args-append   --iasl=/usr/bin/false

# Use MacPorts Python
configure.args-append   --python=${prefix}/bin/python${py_branch}

configure.args-append   --enable-cocoa \
                        --enable-bzip2 \
                        --enable-hvf \
                        --enable-slirp \
                        --enable-lzo \
                        --enable-snappy \
                        --enable-zstd \
                        --disable-tools \
                        --enable-fdt=system \
                        --enable-dmg \
                        --enable-qcow1 \
                        --enable-qed \
                        --enable-vvfat \
                        --enable-vnc \
                        --enable-vnc-jpeg \
                        --disable-vnc-sasl \
                        --enable-png \
                        --enable-libusb \
                        --enable-gnutls \
                        --enable-virtfs \
                        --disable-curses \
                        --disable-capstone \
                        --disable-sdl \
                        --disable-gtk \
                        --disable-opengl \
                        --disable-virglrenderer \
                        --disable-curl \
                        --disable-attr \
                        --disable-vde \
                        --disable-jack \
                        --disable-brlapi \
                        --disable-cap-ng \
