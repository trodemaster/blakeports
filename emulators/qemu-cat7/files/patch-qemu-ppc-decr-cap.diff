hw/ppc: optionally cap the 970 decrementer timer

Mac OS X's pmap_unnest() signals each CPU using a pmap and panics
("Other processor (N) did not see interruption request") unless that
CPU takes some interrupt within LockTimeOut, 250 ms. When the signal
merges into a wake IPI the target is already taking (cpu_signal's
busybitset path), the target serves it from that interrupt and none
follows; an idle CPU, whose decrementer may be set 30 s or more out,
then never updates its interrupt stamp. On hardware the window is a
few hundred ns; under MTTCG, with an MMIO IACK under the BQL in it, it
is wide, and a 10.5 guest with 8 or 16 CPUs panicked within minutes of
a build. IPIs themselves were delivered in under 20 ms (traced).

QEMU_PPC_DECR_CAP_MS=<ms> fires a 970's decrementer timer no later than
that: an early decrementer interrupt, which Mac OS X handles by
re-arming (etimer_intr only fires timers whose deadline has passed).
The DEC value the guest reads is unchanged. With 100 ms every CPU takes
an interrupt well within the 250 ms; 16-CPU builds ran clean.


diff --git a/hw/ppc/ppc.c b/hw/ppc/ppc.c
index df1b2d29e8..2b62e79263 100644
--- a/hw/ppc/ppc.c
+++ b/hw/ppc/ppc.c
@@ -843,6 +843,33 @@ static inline void cpu_ppc_hdecr_lower(PowerPCCPU *cpu)
     ppc_set_irq(cpu, PPC_INTERRUPT_HDECR, 0);
 }
 
+/*
+ * QEMU_PPC_DECR_CAP_MS=<ms>: on 970 CPUs, fire the decrementer timer no
+ * later than that, raising an early decrementer interrupt. Mac OS X's
+ * pmap_unnest() signals a CPU and panics unless that CPU takes some
+ * interrupt within LockTimeOut (250 ms); when the signal merges into a wake
+ * IPI the CPU is already taking, none follows on an idle CPU whose
+ * decrementer is set far out. Under emulation that race is frequent with
+ * many CPUs. Mac OS X handles an early decrementer by re-arming it. The DEC
+ * value the guest reads is unchanged.
+ */
+static int64_t ppc_decr_cap(PowerPCCPU *cpu, QEMUTimer *timer, int64_t now,
+                            int64_t expire)
+{
+    static int64_t cap_ns = -1;
+
+    if (cap_ns < 0) {
+        const char *e = getenv("QEMU_PPC_DECR_CAP_MS");
+
+        cap_ns = e ? atoll(e) * SCALE_MS : 0;
+    }
+    if (cap_ns > 0 && timer == cpu->env.tb_env->decr_timer &&
+        cpu->env.excp_model == POWERPC_EXCP_970 && expire - now > cap_ns) {
+        return now + cap_ns;
+    }
+    return expire;
+}
+
 static void __cpu_ppc_store_decr(PowerPCCPU *cpu, int64_t now, uint64_t *nextp,
                                  QEMUTimer *timer,
                                  void (*raise_excp)(void *),
@@ -896,7 +923,8 @@ static void __cpu_ppc_store_decr(PowerPCCPU *cpu, int64_t now, uint64_t *nextp,
     }
 
     /* Adjust timer */
-    timer_mod(timer, tb_to_ns_round_up(tb_env->decr_freq, next));
+    timer_mod(timer, ppc_decr_cap(cpu, timer, now,
+                                  tb_to_ns_round_up(tb_env->decr_freq, next)));
 }
 
 static inline void _cpu_ppc_store_decr(PowerPCCPU *cpu, int64_t now,
