                        --disable-gcrypt \
                        --disable-nettle \
                        --disable-numa \
                        --disable-xen \
                        --disable-png \
                        --disable-dbus-display \
                        --disable-fuse \
                        --disable-docs \
                        --disable-guest-agent \
                        --disable-virtfs

# The qemu build system bugs out when using in-source-tree builds, so build
# out of source. See the comment in emulators/qemu for the full explanation.
configure.dir           "${workpath}/build"
configure.cmd           "${worksrcpath}/configure"
build.dir               "${workpath}/build"

pre-configure {
    file mkdir ${configure.dir}
}

pre-configure {
    configure.args-append --extra-ldflags="${configure.ldflags}"
}

# disable silent rules
build.args-append       V=1

# Publish suffixed symlinks so both this port and port:qemu can be active.
# Only the two PowerMac emulators are exposed; the tools built alongside them
# (qemu-img and friends) stay in the private prefix, since port:qemu already
# provides those under ${prefix}/bin.
post-destroot {
    xinstall -d ${destroot}${prefix}/bin
    foreach qemu_target {ppc ppc64} {
        ln -s ${qemu_prefix}/bin/qemu-system-${qemu_target} \
              ${destroot}${prefix}/bin/qemu-system-${qemu_target}-mac99-smp
    }
}

notes "
This port installs alongside the stock qemu port. Its emulators are:

    ${prefix}/bin/qemu-system-ppc-mac99-smp
    ${prefix}/bin/qemu-system-ppc64-mac99-smp

Experimental mac99 SMP, for example:

    qemu-system-ppc-mac99-smp -M mac99,via=pmu -cpu g4 -smp 4 \\
        -m 512 -display cocoa -boot c -drive file=leopard.qcow2

Booting more than one CPU also needs a patched OpenBIOS ROM that marks the
secondary CPUs as stopped in the device tree. The ROM shipped with QEMU does
not, so out of the box these binaries boot single-CPU.
"

# Default universal variant does not work
universal_variant       no

livecheck.type          none
