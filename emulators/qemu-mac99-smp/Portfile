PortSystem              1.0

name                    qemu-mac99-smp
version                 11.1.0-rc1
revision                0
categories              emulators
license                 GPL-2+
maintainers             {@trodemaster icloud.com:manuals-unread2u} openmaintainer

description             QEMU with experimental mac99 SMP support for PowerPC guests
long_description        {*}${description}. This is QEMU ${version} with the \
                        experimental multi-CPU (SMP) patches for the mac99 \
                        PowerMac machine model, allowing Mac OS X 10.4 and \
                        10.5 PowerPC guests to boot with up to 4 CPUs. Only \
                        the ppc and ppc64 system targets are built. \
                        It installs alongside the stock qemu port under \
                        ${prefix}/libexec/${name}, exposing its emulators as \
                        qemu-system-ppc-mac99-smp and \
                        qemu-system-ppc64-mac99-smp. \
                        Note that SMP additionally requires a patched \
                        OpenBIOS ROM which advertises the secondary CPUs as \
                        stopped in the device tree, so this port on its own \
                        boots single-CPU only.

homepage                https://www.qemu.org

master_sites            https://download.qemu.org/
distname                qemu-${version}
use_xz                  yes

checksums               rmd160  ba3194453f9738c3448dbd8c031082808fb178b6 \
                        sha256  8d3aae3cc7ce58916cbc3cf7891958e47f82ab7a1c239b9be333f892d1ae3f34 \
                        size    141809476

# This port deliberately coexists with port:qemu rather than conflicting with
# it. Everything is installed into a private prefix so that no file (binary,
# firmware blob under share/qemu, keymap, ...) collides with the stock port,
# and only suffixed symlinks are published into ${prefix}/bin.
#
# QEMU locates its own firmware relative to the running executable
# (util/cutils.c: qemu_init_exec_dir() -> _NSGetExecutablePath() + realpath(),
# then get_relocated_path()), and meson's "relocatable" option defaults to
# true. Because the lookup realpath()s through the symlink, the wrappers below
# resolve to the private prefix and each QEMU finds its matching pc-bios.
set qemu_prefix         ${prefix}/libexec/${name}

set py_branch           3.14
set py_version          [string replace ${py_branch} 1 1]

depends_build-append    port:ninja \
                        path:bin/pkg-config:pkgconfig \
                        port:py${py_version}-distlib \
                        port:py${py_version}-meson

depends_lib-append      path:lib/pkgconfig/glib-2.0.pc:glib2 \
                        path:lib/pkgconfig/pixman-1.pc:libpixman \
                        port:bzip2 \
                        port:libslirp \
                        port:lzo2 \
                        port:snappy \
                        port:zlib \
                        port:zstd \
                        port:dtc

# Experimental mac99 SMP support.
#
# Originally developed by BALATON Zoltan on the qemu-ppc mailing list
# (https://lists.nongnu.org/archive/html/qemu-ppc/2025-02/msg00317.html),
# extended to 4 CPUs by JD
# (https://lists.nongnu.org/archive/html/qemu-ppc/2025-03/msg01151.html),
# and collected by Andrew Randrianasulu at
# https://github.com/Randrianasulu/qemu-mac99-smp (branch 10.0-experiments).
#
# Rebased here from QEMU 10.0 onto ${version}: hw/irq.h moved to
# hw/core/irq.h, and debug leftovers (stderr traces, a duplicated GPIO
# wiring loop) were dropped.
patchfiles-append       patch-mac99-smp.diff

# ERROR: You either need GCC v7.4 or Clang v10.0 (or XCode Clang v15.0)
compiler.blacklist      {clang < 1500} {macports-clang-[3-9].*} {macports-gcc-[56]} {*gcc-[34].*}

if {"${configure.build_arch}" eq "arm64"} {
    set host_cpu "aarch64"
} else {
    set host_cpu "${configure.build_arch}"
}

# Install into the private prefix instead of ${prefix}
configure.pre_args-replace  --prefix=${prefix} --prefix=${qemu_prefix}

configure.args          --cpu=${host_cpu} \
                        --cc=${configure.cc} \
                        --objcc=${configure.objc} \
                        --host-cc=${configure.cc}

# Only the PowerMac targets are of interest here
configure.args-append   --target-list=ppc-softmmu,ppc64-softmmu

# Do not use iasl, even if it is installed, #43911
configure.args-append   --iasl=/usr/bin/false

# Use MacPorts Python
configure.args-append   --python=${prefix}/bin/python${py_branch}

configure.args-append   --enable-cocoa \
                        --enable-bzip2 \
                        --enable-hvf \
                        --enable-slirp \
                        --enable-lzo \
                        --enable-snappy \
                        --enable-zstd \
                        --enable-tools \
                        --enable-fdt=system \
                        --enable-dmg \
                        --enable-qcow1 \
                        --enable-qed \
                        --enable-vvfat \
                        --disable-curses \
                        --disable-capstone \
                        --disable-sdl \
                        --disable-gtk \
                        --disable-opengl \
                        --disable-virglrenderer \
                        --disable-curl \
                        --disable-attr \
                        --disable-vde \
                        --disable-jack \
                        --disable-brlapi \
                        --disable-cap-ng \
                        --disable-spice-protocol \
                        --disable-spice \
                        --disable-libiscsi \
                        --disable-rbd \
                        --disable-smartcard \
                        --disable-libusb \
                        --disable-usb-redir \
                        --disable-seccomp \
                        --disable-linux-aio \
                        --disable-rdma \
                        --disable-libssh \
                        --disable-vnc \
