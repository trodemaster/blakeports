@@ -74,6 +74,7 @@
 #include "kvm_ppc.h"
 #include "hw/usb/usb.h"
 #include "hw/core/sysbus.h"
+#include "hw/core/irq.h"
 #include "trace.h"
 
 #define MAX_IDE_BUS 2
@@ -129,12 +130,48 @@ static void ppc_core99_reset(void *opaque)
     cpu->env.nip = PROM_BASE + 0x100;
 }
 
+/*
+ * Reset and start a secondary CPU. This runs on that CPU's own thread, via
+ * async_run_on_cpu(), rather than on whichever CPU poked the GPIO: cpu_reset()
+ * and ppc_cpu_do_system_reset() mutate the target's state, which is not safe
+ * to do from another vCPU's thread.
+ */
+static void cpu_kick_async(CPUState *cs, run_on_cpu_data data)
+{
+    PowerPCCPU *cpu = POWERPC_CPU(cs);
+
+    cpu_reset(cs);
+
+    /*
+     * Clear the exception prefix *after* the reset, not before. Resetting a
+     * ppc cpu sets MSR[EP], and hreg_store_msr() derives excp_prefix from it
+     * as MSR[EP] * 0xFFF00000, so anything written here beforehand is thrown
+     * away. Leaving it set sends the system reset to 0xFFF00100 in ROM, and
+     * the secondary re-enters OpenBIOS instead of the kernel. With it clear
+     * the vector is 0x00000100, where the OS installs its secondary entry.
+     */
+    cpu->env.excp_prefix = 0;
+
+    ppc_cpu_do_system_reset(cs);
+}
+
+static void cpu_kick(void *opaque, int n, int level)
+{
+    PowerPCCPU *cpu = opaque;
+    CPUState *cs = CPU(cpu);
+
+    if (level) {
+        async_run_on_cpu(cs, cpu_kick_async, RUN_ON_CPU_NULL);
+    }
+}
